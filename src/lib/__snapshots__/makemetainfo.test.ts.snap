exports[`makeMetainfoConsoleApp > emits categories, icon and binary 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
  <id>com.example.test_app</id>
  
  <name>Test App</name>
  <summary>A test application for checking things</summary>
  
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <description>
    <p>
      First paragraph with <code>code</code> and <em>emphasis</em>.
    </p>
    <p>
      Second paragraph. Same para, newline folded.
    </p>
  </description>
  
  <url type="homepage">https://example.com/testapp</url>
  
  <icon type="stock">tool</icon>
  
  <categories>
    <category>Development</category>
    <category>Building</category>
  </categories>
  
  <provides>
    <binary>tool</binary>
  </provides>
</component>"
`;


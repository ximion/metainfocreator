// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meson snippets > builds the localization snippet 1`] = `
"# Localize a MetaInfo file and install it
i18n = import('i18n')

# NOTE: Remember to add the XML file to POTFILES.in!
metainfo_file = '/path/to/com.example.test_app.metainfo.xml'
i18n.merge_file(
    input:  metainfo_file,
    output: 'com.example.test_app.metainfo.xml',
    type: 'xml',
    po_dir: join_paths (meson.source_root(), 'po'),
    install: true,
    install_dir: join_paths (get_option ('datadir'), 'metainfo')
)"
`;

exports[`meson snippets > builds the metainfo-to-desktop-entry snippet 1`] = `
"# Create desktop-entry file from metainfo
metainfo_file = '/path/to/com.example.test_app.metainfo.xml'
ascli_exe = find_program('appstreamcli')
custom_target('gen-desktop-entry',
    input : [metainfo_file],
    output : ['com.example.test_app.desktop'],
    command : [ascli_exe, 'make-desktop-file', '@INPUT@', '@OUTPUT@'],
    install: true,
    install_dir: join_paths (get_option ('datadir'), 'applications')
)"
`;

exports[`meson snippets > builds the validation testcase 1`] = `
"# Validate MetaInfo file
metainfo_file = '/path/to/com.example.test_app.metainfo.xml'
ascli_exe = find_program('appstreamcli', required: false)
if ascli_exe.found()
  test('validate metainfo file',
        ascli_exe,
        args: ['validate',
               '--no-net',
               '--pedantic',
               metainfo_file]
  )
endif"
`;

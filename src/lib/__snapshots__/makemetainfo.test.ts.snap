exports[`makeMetainfoGuiApp > uses a provided desktop-entry name 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.example.test_app</id>
  
  <name>Test App</name>
  <summary>A test application for checking things</summary>
  
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <description>
    <p>
      First paragraph with <code>code</code> and <em>emphasis</em>.
    </p>
    <p>
      Second paragraph. Same para, newline folded.
    </p>
  </description>
  
  <url type="homepage">https://example.com/testapp</url>
  
  <launchable type="desktop-id">com.example.test_app.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://example.com/a.png</image>
    </screenshot>
    <screenshot>
      <image>https://example.com/b.png</image>
    </screenshot>
  </screenshots>
</component>"
`;

exports[`makeMetainfoService > emits both categories 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<component type="service">
  <id>com.example.test_app</id>
  
  <name>Test App</name>
  <summary>A test application for checking things</summary>
  
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <description>
    <p>
      First paragraph with <code>code</code> and <em>emphasis</em>.
    </p>
    <p>
      Second paragraph. Same para, newline folded.
    </p>
  </description>
  
  <url type="homepage">https://example.com/testapp</url>
  
  <launchable type="service">testd</launchable>
  
  <icon type="stock">daemon</icon>
  
  <categories>
    <category>Network</category>
    <category>WebDevelopment</category>
  </categories>
</component>"
`;

